# =============================================================================
#  Git Ignore Rules for DXSpider Docker
#
#  Prevents secrets, runtime data, and per-node configuration from being
#  committed to version control. Use .env.example and defaults/* as templates.
# =============================================================================

# --- Secrets / local environment ---
# .env contains passwords and node-specific identity; never commit it.
.env
.env.local
.env.*.local

# --- Runtime data (persisted via Docker bind mounts, not in git) ---
# local_data/ holds the user database, spots, logs, MOTD files, and filter lists.
local_data/*
!local_data/.gitkeep

# --- Per-node runtime artifacts ---
# connect/ and msg/ contain node-specific scripts and messages.
# Exception: connect/partner-call is a tracked template.
connect/*
!connect/.gitkeep
!connect/partner-call
msg/*
!msg/.gitkeep

# --- local_cmd/ holds user-edited crontab, startup, and custom local commands ---
# Seeded automatically from defaults/ on first boot so git pull never conflicts.
local_cmd/*
!local_cmd/.gitkeep
!local_cmd/.placeholder

# --- Legacy root-level config files (migrated to local_cmd/ and local_data/) ---
startup
motd
motd_nor

# --- Backup archives ---
*.tar.gz

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.bak
*.tmp
AGENTS.md
