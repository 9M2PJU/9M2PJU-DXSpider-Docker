# =============================================================================
#  9M2PJU DXSpider Docker — Environment Configuration Template
#
#  Copy this file to `.env` and edit before running `docker compose up -d`:
#    cp .env.example .env
#    nano .env
#
#  All variables have sensible defaults — only CLUSTER_CALLSIGN and
#  CLUSTER_SYSOP_CALLSIGN are truly required for a working node.
# =============================================================================

# --- Cluster identity ---
# The callsign of your DX Cluster node (SSID allowed, e.g. -2 for a cluster)
CLUSTER_CALLSIGN=N0CALL-2
# DXSpider git branch: "mojo" (recommended, active development) or "master"
CLUSTER_DXSPIDER_BRANCH=mojo
# Pin DXSpider to a specific commit SHA for reproducible builds.
# Leave commented to use the pinned default from the Dockerfile.
# Set to a newer SHA to upgrade DXSpider, then rebuild:
#   docker compose build --build-arg SPIDER_GIT_REF=<new-sha>
# SPIDER_GIT_REF=3e9b3621d94dd45c68702e4a0f896aac33f2a91d

# --- Sysop (admin) ---
# Your name (shown in cluster info)
CLUSTER_SYSOP_NAME=Your Name
# Your amateur radio callsign (admin login)
CLUSTER_SYSOP_CALLSIGN=9M2PJU
# Sysop password (currently unused by DXSpider — auth is via callsign)
CLUSTER_SYSOP_PASSWORD=

# --- Location (Maidenhead grid square + lat/lon) ---
# Grid square is used for distance/bearing calculations to DX spots.
# Find yours at: https://www.amsat.org/tools/grid-square-locator/
CLUSTER_LOCATOR=OJ03UD
# Latitude/longitude in decimal degrees (sign matters: +N/-S, +E/-W)
CLUSTER_LATITUDE=+03.08
CLUSTER_LONGITUDE=+101.41
# Human-readable QTH description (shown to connecting users)
CLUSTER_QTH=Kuala Lumpur, Malaysia

# --- Sysop contact details ---
# Email where users can contact you for registration/support
CLUSTER_SYSOP_EMAIL=9m2pju@hamradio.my
# BBS forwarding address (for message routing; leave empty if unsure)
CLUSTER_SYSOP_BBS_ADDRESS=

# --- Network ports ---
# Telnet port: users connect here with telnet or a DX Cluster client
CLUSTER_PORT=7300
# Web Console port: sysop admin interface via browser (ttyd)
CLUSTER_SYSOP_PORT=8080

# --- Optional MariaDB backend for spot logging ---
# By default, DXSpider uses flat-file storage (DB_File + SQLite), which is
# sufficient for most nodes. To enable MariaDB for spot logging:
#   1. Uncomment all lines below
#   2. Set CLUSTER_DB_HOSTNAME=db (matches the compose service name)
#   3. Start with the with-db profile:
#        docker compose --profile with-db up -d --build
# CLUSTER_DB_USER=sysop
# CLUSTER_DB_PASS=changeme-db
# CLUSTER_DB_ROOT_PWD=changeme-root
# CLUSTER_DB_NAME=spider
# CLUSTER_DB_HOSTNAME=db
# CLUSTER_DB_PORT=3306

# --- Web Console credentials (ttyd HTTP basic auth) ---
# Change these from the defaults! Anyone with these creds has sysop access.
WEB_USER=sysop
WEB_PASS=changeme-web

# --- Advanced ---
# Set to "yes" to force-regenerate DXVars.pm and Listeners.pm on every start.
# Useful when you change env vars and want them applied without manually
# deleting the config files. Set back to "no" to preserve manual edits.
OVERWRITE_CONFIG=no
# UID for the sysop user inside the container.
# Match your host user's UID for hassle-free bind-mount permissions:
#   echo $UID  (on the host)
# If you can't match UIDs, the entrypoint will chown the volumes on startup
# (requires the CHOWN capability, which is enabled by default).
# SPIDER_UID=1000
