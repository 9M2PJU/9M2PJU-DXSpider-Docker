# =============================================================================
#  DXSpider Startup Commands
#
#  This file is bind-mounted into the container at /spider/scripts/startup
#  and is executed once when DXSpider starts (after the cluster daemon boots).
#  Each line is a DXSpider console command.
#
#  Edit to suit your node, then restart:
#    docker compose restart dxspider
# =============================================================================

# Load message forwarding configuration
load/forward

# Mark a partner node as a DXSpider-type node and connect to it.
# Replace 'partner-call' with the callsign of a DIFFERENT node (lowercase).
# Do NOT put your own node's callsign here — that would make the cluster
# try to connect to itself.
set/spider partner-call
connect partner-call

# Allow inbound internet connections
set/var $Internet::allow = 1

# Set the contest DX cluster host for contest spot forwarding
set/var $Internet::contest_host = "contest.dxtron.com"

# Require users to register before they can post spots.
# This prevents anonymous spam spots on your node.
set/var $main::reqreg = 1
